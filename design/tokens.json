{
  "meta": {
    "source": "UI-UX redesign spec §2–§6 (semantic tokens, light + dark). Components must use semantic tokens only — never raw hex.",
    "focus": { "width_px": 2, "offset_px": 2 },
    "dark_mode": {
      "selector": "[data-theme=\"dark\"]",
      "storage_key": "sh-theme",
      "default": "system"
    }
  },
  "color": {
    "bg": "#F5F6FA",
    "surface": "#FFFFFF",
    "surface-2": "#EEF0F6",
    "surface-3": "#E6E9F2",
    "border": "#E1E4EE",
    "border-strong": "#C9CEDD",
    "text": "#14162A",
    "text-muted": "#555A73",
    "text-subtle": "#6A6F88",
    "primary": "#3F4FE0",
    "primary-hover": "#3140C4",
    "primary-soft": "#E9ECFF",
    "on-primary": "#FFFFFF",
    "calm": "#1F9D74",
    "calm-fg": "#14684D",
    "calm-soft": "#E0F5EC",
    "neutral": "#D99A1E",
    "neutral-fg": "#8A5A00",
    "neutral-soft": "#FBF0D6",
    "stress": "#E0553A",
    "stress-fg": "#A82F18",
    "stress-soft": "#FDE7E1",
    "info": "#3F4FE0",
    "info-fg": "#2B3BB3",
    "info-soft": "#E9ECFF",
    "scrim": "rgba(20,22,42,0.45)"
  },
  "dark": {
    "bg": "#0C0E14",
    "surface": "#141722",
    "surface-2": "#1B1F2E",
    "surface-3": "#232840",
    "border": "#272C3F",
    "border-strong": "#3A4160",
    "text": "#ECEEF6",
    "text-muted": "#A4A9BE",
    "text-subtle": "#8A90A8",
    "primary": "#8B97FF",
    "primary-hover": "#A3ACFF",
    "primary-soft": "#1E2447",
    "on-primary": "#0C0E14",
    "calm": "#3CCB9B",
    "calm-fg": "#7BE3C0",
    "calm-soft": "#10302A",
    "neutral": "#F0B64A",
    "neutral-fg": "#F7CD80",
    "neutral-soft": "#352A12",
    "stress": "#FF7A5C",
    "stress-fg": "#FFA48E",
    "stress-soft": "#3B1A14",
    "info": "#8B97FF",
    "info-fg": "#B5BDFF",
    "info-soft": "#1E2447",
    "scrim": "rgba(0,0,0,0.6)"
  },
  "type": {
    "font-sans": "Inter Variable",
    "font-display": "Manrope Variable",
    "display": { "size": "44px", "line-height": "48px", "weight": 700, "tracking": "-0.02em" },
    "numeral-xl": { "size": "64px", "line-height": "64px", "weight": 700, "tracking": "-0.03em" },
    "h1": { "size": "30px", "line-height": "36px", "weight": 700, "tracking": "-0.015em" },
    "h2": { "size": "22px", "line-height": "28px", "weight": 650, "tracking": "-0.01em" },
    "h3": { "size": "18px", "line-height": "24px", "weight": 600, "tracking": "-0.005em" },
    "body": { "size": "16px", "line-height": "24px", "weight": 400, "tracking": "0" },
    "body-strong": { "size": "16px", "line-height": "24px", "weight": 600, "tracking": "0" },
    "secondary": { "size": "14px", "line-height": "20px", "weight": 400, "tracking": "0" },
    "caption": { "size": "12px", "line-height": "16px", "weight": 500, "tracking": "0.01em" }
  },
  "radius": {
    "control": 10,
    "card": 16,
    "dialog": 20,
    "hero": 24,
    "pill": 999
  },
  "shadow": {
    "elev-1": "0 1px 2px rgba(20,22,42,.05), 0 0 0 1px #E1E4EE",
    "elev-2": "0 8px 24px rgba(20,22,42,.10), 0 0 0 1px #E1E4EE",
    "elev-3": "0 24px 64px rgba(20,22,42,.18)"
  },
  "shadow-dark": {
    "elev-1": "0 0 0 1px #272C3F",
    "elev-2": "0 8px 24px rgba(0,0,0,.45), 0 0 0 1px #3A4160",
    "elev-3": "0 24px 64px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.04)"
  },
  "space": [4, 8, 12, 16, 20, 24, 32, 40, 56, 72],
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "ease-out": "cubic-bezier(.2,.8,.2,1)",
    "ease-in-out": "cubic-bezier(.4,0,.2,1)"
  }
}
