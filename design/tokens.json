{
  "meta": {
    "source": "docs/spec/02-design-system-ux.md section 2 (light theme only, per LEAN 1.3)",
    "adjustments": [
      {
        "token": "color.text-subtle",
        "from": "#74746C",
        "to": "#6B6B63",
        "reason": "measured 3.97:1 on bg, below the 4.5:1 caption bar; File 02 2.5 prescribes adjusting the token and logging in GATES_CHANGELOG.md"
      }
    ],
    "focus": { "width_px": 2, "offset_px": 2 }
  },
  "color": {
    "bg": "#F7F7F4",
    "surface": "#FFFFFF",
    "surface-2": "#F1F1EC",
    "border": "#E4E4DD",
    "text": "#171714",
    "text-muted": "#5B5B54",
    "text-subtle": "#6B6B63",
    "primary": "#3549D8",
    "primary-hover": "#2B3BB3",
    "primary-soft": "#EAEEFF",
    "on-primary": "#FFFFFF",
    "calm": "#2F8F6B",
    "calm-fg": "#1D6449",
    "calm-soft": "#E2F4EC",
    "neutral": "#C58A1B",
    "neutral-fg": "#8A5A0B",
    "neutral-soft": "#FBF1D9",
    "stress": "#D4532F",
    "stress-fg": "#A93A1B",
    "stress-soft": "#FCE6DE",
    "focus-ring": "#3549D8"
  },
  "type": {
    "font-sans": "Inter Variable",
    "display": { "size": "40px", "line-height": "44px", "weight": 600 },
