{
  "meta": {
    "source": "UI-UX v2 redesign — Quiet instrument (Fraunces + Instrument Sans + JetBrains Mono, paper/ink). State colours kept from UI-UX 2.2 so the child app stays aligned.",
    "focus": {
      "width_px": 2,
      "offset_px": 2
    },
    "dark_mode": {
      "selector": "[data-theme=\"dark\"]",
      "storage_key": "sh-theme",
      "default": "system"
    }
  },
  "color": {
    "bg": "#F3F0E9",
    "surface": "#FBF9F4",
    "surface-2": "#ECE8DF",
    "surface-3": "#E3DED2",
    "border": "#DDD8CB",
    "border-strong": "#BDB7A7",
    "text": "#1A1916",
    "text-muted": "#5B574D",
    "text-subtle": "#61667E",
    "primary": "#3B46D9",
    "primary-hover": "#2F3AC4",
    "primary-soft": "#EAECFF",
    "on-primary": "#FFFFFF",
    "calm": "#1F9D74",
    "calm-fg": "#14684D",
    "calm-soft": "#E0F5EC",
    "neutral": "#D99A1E",
    "neutral-fg": "#8A5A00",
    "neutral-soft": "#FBF0D6",
    "stress": "#E0553A",
    "stress-fg": "#A82F18",
    "stress-soft": "#FDE7E1",
    "info": "#3F4FE0",
    "info-fg": "#2B3BB3",
    "info-soft": "#E9ECFF",
    "scrim": "rgba(26,25,22,0.45)",
    "rule": "#DDD8CB",
    "rule-strong": "#BDB7A7"
  },
  "dark": {
    "bg": "#0E0E10",
    "surface": "#17171A",
    "surface-2": "#1F1F23",
    "surface-3": "#26262B",
    "border": "#2B2B30",
    "border-strong": "#44444B",
    "text": "#EFECE4",
    "text-muted": "#A8A498",
    "text-subtle": "#8A90A8",
    "primary": "#8E98FF",
    "primary-hover": "#A3ACFF",
    "primary-soft": "#1E2047",
    "on-primary": "#0E0E10",
    "calm": "#3CCB9B",
    "calm-fg": "#7BE3C0",
    "calm-soft": "#10302A",
    "neutral": "#F0B64A",
    "neutral-fg": "#F7CD80",
    "neutral-soft": "#352A12",
    "stress": "#FF7A5C",
    "stress-fg": "#FFA48E",
    "stress-soft": "#3B1A14",
    "info": "#8B97FF",
    "info-fg": "#B5BDFF",
    "info-soft": "#1E2447",
    "scrim": "rgba(0,0,0,0.6)",
    "rule": "#2B2B30",
    "rule-strong": "#44444B"
  },
  "type": {
    "font-sans": "Instrument Sans Variable",
    "font-display": "Fraunces Variable",
    "display": {
      "size": "34px",
      "line-height": "40px",
      "weight": 600,
      "tracking": "-0.02em"
    },
    "numeral-xl": {
      "size": "56px",
      "line-height": "56px",
      "weight": 600,
      "tracking": "-0.02em"
    },
    "h1": {
      "size": "28px",
      "line-height": "34px",
      "weight": 600,
      "tracking": "-0.015em"
    },
    "h2": {
      "size": "22px",
      "line-height": "28px",
      "weight": 650,
      "tracking": "-0.01em"
    },
    "h3": {
      "size": "18px",
      "line-height": "24px",
      "weight": 600,
      "tracking": "0"
    },
    "body": {
      "size": "16px",
      "line-height": "24px",
      "weight": 400,
      "tracking": "0"
    },
    "body-strong": {
      "size": "16px",
      "line-height": "24px",
      "weight": 600,
      "tracking": "0"
    },
    "secondary": {
      "size": "14px",
      "line-height": "20px",
      "weight": 400,
      "tracking": "0"
    },
    "caption": {
      "size": "12px",
      "line-height": "16px",
      "weight": 500,
      "tracking": "0"
    },
    "font-mono": "JetBrains Mono Variable",
    "mono": {
      "size": "13px",
      "line-height": "20px",
      "weight": 450,
      "tracking": "0"
    }
  },
  "radius": {
    "chip": 4,
    "control": 10,
    "panel": 20,
    "pill": 999
  },
  "shadow": {
    "elev-1": "0 1px 2px rgba(26,25,22,.05), 0 0 0 1px #DDD8CB",
    "elev-2": "0 8px 24px rgba(26,25,22,.10), 0 0 0 1px #DDD8CB",
    "elev-3": "0 24px 64px rgba(26,25,22,.18)"
  },
  "shadow-dark": {
    "elev-1": "0 0 0 1px #2B2B30",
    "elev-2": "0 8px 24px rgba(0,0,0,.45), 0 0 0 1px #44444B",
    "elev-3": "0 24px 64px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.04)"
  },
  "space": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    56,
    72
  ],
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "ease-out": "cubic-bezier(.2,.8,.2,1)",
    "ease-in-out": "cubic-bezier(.4,0,.2,1)"
  }
}
